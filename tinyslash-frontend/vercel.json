{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "build": {
    "env": {
      "DISABLE_ESLINT_PLUGIN": "true",
      "ESLINT_NO_DEV_ERRORS": "true",
      "TSC_COMPILE_ON_ERROR": "true"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.tinyslash.com/api/$1"
    },
    {
      "source": "/actuator/(.*)",
      "destination": "https://api.tinyslash.com/actuator/$1"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/index.html"
    },
    {
      "source": "/profile",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/careers",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/qr-generator",
      "destination": "/index.html"
    },
    {
      "source": "/domains",
      "destination": "/index.html"
    },
    {
      "source": "/account-settings",
      "destination": "/index.html"
    },
    {
      "source": "/short-links",
      "destination": "/index.html"
    },
    {
      "source": "/qr-codes",
      "destination": "/index.html"
    },
    {
      "source": "/file-to-link",
      "destination": "/index.html"
    },
    {
      "source": "/pages",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/blog",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/shipping-policy",
      "destination": "/index.html"
    },
    {
      "source": "/cancellation-refund",
      "destination": "/index.html"
    },
    {
      "source": "/solutions",
      "destination": "/index.html"
    },
    {
      "source": "/auth",
      "destination": "/index.html"
    },
    {
      "source": "/invite",
      "destination": "/index.html"
    },
    {
      "source": "/file",
      "destination": "/index.html"
    },
    {
      "source": "/unlock",
      "destination": "/index.html"
    },
    {
      "source": "/verified",
      "destination": "/index.html"
    },
    {
      "source": "/redirect",
      "destination": "/index.html"
    },
    {
      "source": "/p",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/file_(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/qr_(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/([a-zA-Z0-9_-]+)",
      "destination": "https://api.tinyslash.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}